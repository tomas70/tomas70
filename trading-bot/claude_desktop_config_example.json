{
  "_comment": "Pridėk šį bloką į savo Claude Desktop konfigūracijos failą.",
  "_config_path_mac":     "~/Library/Application Support/Claude/claude_desktop_config.json",
  "_config_path_windows": "%APPDATA%\\Claude\\claude_desktop_config.json",

  "mcpServers": {
    "trading-bot": {
      "command": "python",
      "args": ["/ABSOLUTE/PATH/TO/trading-bot/mcp_server.py"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "1234567890:AAF...",
        "TELEGRAM_CHAT_ID":   "-100123456789"
      }
    }
  }
}

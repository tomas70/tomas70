# ── Telegram (optional) ───────────────────────────────────────────────────────
# Only needed to receive setup notifications via Telegram.
# Create a bot at https://t.me/BotFather, then get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Standalone mode only ──────────────────────────────────────────────────────
# Only needed when running main.py WITHOUT Claude Desktop.
# Leave empty when using mcp_server.py with Claude Desktop.
ANTHROPIC_API_KEY=

# ── Hyperliquid account (required for live balance/status) ───────────────────
# Your PUBLIC wallet address (starts with 0x...) — never your private key.
# Used only to read account value and trade history via Hyperliquid's public
# info API; the bot never signs or places orders.
HYPERLIQUID_ADDRESS=

# NOTE: No API key needed for market data or account reads — both come from
# Hyperliquid's public REST endpoints (candles: no auth; account: address only).

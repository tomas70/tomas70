# ── Telegram (optional) ───────────────────────────────────────────────────────
# Only needed to receive setup notifications via Telegram.
# Create a bot at https://t.me/BotFather, then get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Standalone mode only ──────────────────────────────────────────────────────
# Only needed when running main.py WITHOUT Claude Desktop.
# Leave empty when using mcp_server.py with Claude Desktop.
ANTHROPIC_API_KEY=

# ── Evedex account (required for live balance/status) ─────────────────────────
# Read-only API key — create one on the Evedex exchange under
# Settings -> API -> Create API Key. Used only to read account value and
# closed-position history; the bot never signs or places orders.
EVEDEX_API_KEY=

# NOTE: Market data (candles, instruments, order book) needs no key — it's
# all public Evedex REST. Only balance/status reads need EVEDEX_API_KEY.
